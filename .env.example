# Synthetic local demo only. No paid API key is needed.
# Copy to .env; the local Docker Compose launcher reads it automatically.
BIDFIT_PORT=8000
# Optional namespace to keep this demo separate from other Docker projects.
COMPOSE_PROJECT_NAME=bidfit-local

# Local Docker services use fixed demonstration-only DB/storage credentials.
# Do not add a real RFQ, company secret, OIDC credential or LLM key for this demo.
# EXTERNAL PROVIDER EGRESS STAYS DISABLED.
# See docs/CONFIGURATION.md for future approved external integrations.
